# Settings for the Character Consistency Workbench.
# app/workbench/config.py reads this file first, then app/.env, then environment
# variables, and the last one wins. Put your key and any changes in app/.env,
# which git ignores. Never put a real key in this file.
# Model IDs, reasoning effort, token limits, per-model rate limits, and token
# prices go in app/prompts/models.v1.toml (from M2), versioned with the prompts.

# Address the server listens on. 127.0.0.1 keeps it on this machine.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8492

# SQLite database file, relative to app/. Git ignores app/data/.
WORKBENCH_DB_PATH=data/workbench.db

# Model service: gemini (Google AI Studio), ollama (local), or fake (no network).
WORKBENCH_PROVIDER=gemini

# Google AI Studio key. Leave it empty here and set it in app/.env.
GEMINI_API_KEY=

# Google's OpenAI-compatible endpoint for Gemini.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local Ollama server, used when WORKBENCH_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Limits. Starting values, tuned in M6.
# Model calls per Pacific day (when the free quota resets) before the app stops calling.
WORKBENCH_DAILY_CALL_CAP=200
# Runs one browser session may start.
WORKBENCH_SESSION_RUN_LIMIT=10
# Seconds to wait for a reply's first token before showing an error card.
WORKBENCH_FIRST_TOKEN_TIMEOUT_SECONDS=30
