# Settings for the Character Consistency Workbench.
# app/workbench/config.py reads this file first, then app/.env, then environment
# variables, and the last one wins. Put your key and any changes in app/.env,
# which git ignores. Never put a real key in this file. Settings in the app
# (the top bar) writes the provider, the key, the models, and the limits to
# app/.env for you.
# Model IDs, reasoning effort, token limits, and token prices go in the models
# file in app/prompts/, versioned with the prompts. The per-minute limit and the
# daily cap are machine settings, so they live here.

# Address the server listens on. 127.0.0.1 keeps it on this machine.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8492

# SQLite database file, relative to app/. Git ignores app/data/.
WORKBENCH_DB_PATH=data/workbench.db

# Model service: gemini (Google AI Studio), ollama (local), fake (no network),
# or openai_compatible (any other OpenAI-compatible service).
WORKBENCH_PROVIDER=gemini

# Google AI Studio key. Leave it empty here and set it in app/.env.
GEMINI_API_KEY=

# Google's OpenAI-compatible endpoint for Gemini.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local Ollama server, used when WORKBENCH_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Another OpenAI-compatible service, used when WORKBENCH_PROVIDER=openai_compatible:
# its base URL, like https://api.example.com/v1, and its key. A service on this
# computer may need no key. Leave the key empty here and set it in app/.env.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# The model that plays the character, and the AI judge's model. Empty uses the
# defaults in the models file in app/prompts/. Settings picks them from the
# models file's menus or the models Ollama has installed, or as typed for
# another OpenAI-compatible service, where both are needed.
WORKBENCH_CHARACTER_MODEL=
WORKBENCH_JUDGE_MODEL=

# Limits. They keep a demo or a study session inside Google's free quota.
# Model calls per Pacific day (when the free quota resets) before the app stops calling.
WORKBENCH_DAILY_CALL_CAP=200
# Model calls per minute. Calls start at least 60/N seconds apart. 15 is the free
# limit for both Gemini Flash-Lite models (AI Studio rate-limit page, Oct 9, 2026).
WORKBENCH_CALLS_PER_MINUTE=15
# Runs one browser session (one browser tab) may start.
WORKBENCH_SESSION_RUN_LIMIT=10
# AI judge calls one browser session may make: each Check this chat or Re-check
# that asks the AI. A saved check shown again doesn't count.
WORKBENCH_SESSION_JUDGE_LIMIT=20
# Settings in the app changes both session limits, each from 1 up to the daily cap.

# Model errors. A call that gets 429 (the free limit) or a 5xx (a service
# problem) is tried again this many times on the same model, then once on the
# fallback model in the models file, before the error card shows.
WORKBENCH_RETRIES=2
# Seconds before the first retry. Each retry waits twice as long as the one before.
WORKBENCH_RETRY_BACKOFF_SECONDS=2
# Forces a 429 for the demo, without calling the service. off: normal calls.
# primary: the first model always fails, so the fallback model answers. all:
# every model fails, so the error card and the rules-only check show.
# The "Simulate a busy AI service" switch in Settings sets primary until the
# server restarts, without changing this file.
WORKBENCH_FORCE_MODEL_ERROR=off
# Seconds to wait for a reply's first token before showing an error card.
WORKBENCH_FIRST_TOKEN_TIMEOUT_SECONDS=30
# Seconds to wait for the AI judge's whole answer when you check a chat. The
# judge thinks first and then answers in one piece, so it gets longer.
WORKBENCH_JUDGE_TIMEOUT_SECONDS=120
# The longest message the creator can type, in characters.
WORKBENCH_MAX_TYPED_CHARS=2000
# The longest chat Import accepts, in characters.
WORKBENCH_MAX_IMPORT_CHARS=300000

# The seeded transcript, relative to app/. The server reads it only when the
# creator picks it in Import.
WORKBENCH_SEEDED_TRANSCRIPT_PATH=../validation/fixtures/SEEDED_TRANSCRIPT.md
